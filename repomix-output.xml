    const diffMs = nowMs - new Date(latestAnswered).getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

    if (diffDays <= 0) return "최근 답변 오늘";
    if (diffDays === 1) return "최근 답변 1일 전";
