@media (max-width: 768px) {

  .top-bar {
    width: 100%;
    box-sizing: border-box;
    height: 70px;
  }

  .top-nav-btn {
    display: inline-flex;
    align-items: center;
    margin-top: 25px;
    justify-content: center;
    grid-row: 1;
    border: none;
    background: transparent;
    color: rgba(66, 40, 112, 0.72);
    font-family: "MyFont";
    font-size: 18px;
    font-weight: 400;
    cursor: pointer;
    opacity: 0.85;
    text-shadow: 0 1px 10px rgba(190, 160, 240, 0.18);
    transition:
      color 0.18s ease,
      opacity 0.18s ease,
      transform 0.15s ease,
      background 0.18s ease;
  }

  .top-nav-btn.left {
    grid-column: 1;
    justify-self: start;
  }

  .top-nav-btn.right {
    grid-column: 3;
    justify-self: end;
  }

  .top-nav-btn:hover {
    opacity: 1;
    transform: translateY(-1px);
    text-shadow: 0 2px 14px rgba(176, 138, 235, 0.32);
  }

  .top-nav-btn.active {
    color: rgba(58, 31, 105, 0.98);
    opacity: 1;
    text-shadow:
      0 2px 16px rgba(176, 138, 235, 0.42),
      0 0 1px rgba(255, 255, 255, 0.3);
  }

  .mobile-tabs {
    display: none;
  }

  .app-shell {
    display: block;
    width: 100%;
    height: auto;
    min-height: 100vh;
    overflow: visible;
    padding: 92px 14px 180px;
    box-sizing: border-box;
  }


  .ask-area-wrap {
    width: calc(100vw - 28px);
    max-width: none;
  }

  .ask-input-shell {
    width: 100%;
    margin-left: 0;
    transform: none;
  }


  .question-line {
    width: 100%;
  }

  .profile-panel,
  .chat-panel,
  .archive-panel {
    display: none;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .profile-panel.is-mobile-active,
  .chat-panel.is-mobile-active,
  .archive-panel.is-mobile-active {
    display: block !important;
  }

  .profile-panel.is-mobile-active .profile-public {
    display: block;
    width: 100%;
  }

  .chat-panel.guest-view,
  .chat-panel.owner-view {
    margin: 0;
    width: 100%;
  }



  .question-bubble {
    overflow: visible;
  }

  .answer-box {
    overflow: visible;
  }

  .card-actions {
    display: flex;
    justify-content: flex-start;
    margin-top: 8px;
  }

  .message-input {
    font-size: 13px;
  }

  .image-zoom-modal {
    padding: 12px;
  }

  .image-zoom-modal-content {
    width: 100%;
    max-height: 86vh;
  }

  .image-zoom-modal-content img {
    max-height: 86vh;
    border-radius: 14px;
  }

  .image-zoom-close {
    top: -4px;
    right: -2px;
  }

  .image-zoom-nav.prev {
    left: 4px;
  }

  .image-zoom-nav.next {
    right: 4px;
  }

}

