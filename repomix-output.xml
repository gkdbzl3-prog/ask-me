@media (max-width: 768px) {
  .top-bar {
    width: 100%;
    box-sizing: border-box;
  }


  .app-shell {
    display: block;
    width: 100%;
    height: auto;
    min-height: 100vh;
    overflow: visible;
    padding: 92px 14px 180px;
    box-sizing: border-box;
  }


  .ask-area-wrap {
    bottom: 82px;
    width: calc(100vw - 28px);
    max-width: none;
  }

  .ask-input-shell {
    width: 100%;
    margin-left: 0;
    transform: none;
  }

  .mobile-tab-profile .ask-input-shell {
    display: none;
  }

  .mobile-tab-archive .ask-input-shell {
    display: none;
  }

  .mobile-tab-chat .ask-input-shell {
    display: flex;
  }

  .question-line {
    width: 100%;
  }

  .profile-panel,
  .chat-panel,
  .archive-panel {
    display: none;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .profile-panel.is-mobile-active,
  .chat-panel.is-mobile-active,
  .archive-panel.is-mobile-active {
    display: block !important;
  }

  .profile-panel.is-mobile-active .profile-public {
    display: block;
    width: 100%;
  }

  .chat-panel.guest-view,
  .chat-panel.owner-view {
    margin: 0;
    width: 100%;
  }


  .mobile-tabs {
    position: fixed;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 60;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    height: 54px;
    padding: 7px;
    border: 1px solid rgba(169, 120, 230, 0.24);
    border-radius: 18px;
    background: rgba(255, 250, 255, 0.86);
    box-shadow: 0 14px 34px rgba(72, 45, 120, 0.18);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }



  .mobile-tabs .nav-btn {
    border: none;
    background: transparent;
    padding: 0;
    color: rgba(66, 40, 112, 0.72);
    font-weight: 400;
    font-family: "MyFont";
    letter-spacing: 0;
    cursor: pointer;
    text-shadow: 0 1px 10px rgba(190, 160, 240, 0.18);
    transition:
      color 0.18s ease,
      opacity 0.18s ease,
      transform 0.15s ease,
      text-shadow 0.18s ease;
    opacity: 0.72;
    font-size: 14px;
    position: static;
    border-radius: 13px;
  }

  .mobile-tabs .nav-btn:hover {
    background: linear-gradient(180deg,
        rgba(255, 255, 255, 0.94) 0%,
        rgba(250, 245, 255, 0.84) 100%);
    color: rgba(66, 40, 112, 0.9);
    opacity: 1;
    transform: translateY(-1px);
    text-shadow: 0 2px 14px rgba(176, 138, 235, 0.28);
  }

  .mobile-tabs .nav-btn.active {
    background: linear-gradient(190deg,
        rgba(186, 148, 240, 0.42) 0%,
        rgba(169, 120, 230, 0.3) 100%);
    border-color: rgba(169, 120, 230, 0.52);
    color: rgba(58, 31, 105, 0.98);
    opacity: 1;
    text-shadow:
      0 2px 16px rgba(176, 138, 235, 0.34),
      0 0 1px rgba(255, 255, 255, 0.28);
  }



  .question-bubble {
    overflow: visible;
  }

  .answer-box {
    overflow: visible;
  }

  .card-actions {
    display: flex;
    justify-content: flex-start;
    margin-top: 8px;
  }

  .message-input {
    font-size: 13px;
  }

  .image-zoom-modal {
    padding: 12px;
  }

  .image-zoom-modal-content {
    width: 100%;
    max-height: 86vh;
  }

  .image-zoom-modal-content img {
    max-height: 86vh;
    border-radius: 14px;
  }

  .image-zoom-close {
    top: -4px;
    right: -2px;
  }

  .image-zoom-nav.prev {
    left: 4px;
  }

  .image-zoom-nav.next {
    right: 4px;
  }

}

